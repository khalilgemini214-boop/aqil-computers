{
  "name": "aqil-computers",
  "version": "1.0.0",
  "private": true,
  "description": "Aqil Computers — offline inventory, costing, sales and customer ledger",
  "scripts": {
    "sync": "node sync.js",
    "build": "node sync.js",
    "deploy": "node sync.js && wrangler deploy",
